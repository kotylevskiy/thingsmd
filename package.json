{
  "name": "thingsmd-dev",
  "private": true,
  "type": "module",
  "scripts": {
    "debug:check": "node scripts/check-obsidian.mjs",
    "deploy": "npm run build && node scripts/deploy.mjs",
    "dev:open": "node scripts/open-prototype.mjs",
    "test": "node --test tests/*.test.cjs",
    "test:ui": "node scripts/test-prototype.mjs",
    "dev:native": "node scripts/open-native.mjs",
    "test:native": "node scripts/test-native.mjs",
    "test:navigation": "node scripts/test-navigation.mjs",
    "test:drag": "node scripts/test-drag.mjs",
    "test:reading": "node scripts/test-reading.mjs",
    "test:storage": "node scripts/test-storage.mjs",
    "test:capture": "node scripts/test-capture.mjs",
    "test:lists": "node scripts/test-lists.mjs",
    "test:archives": "node scripts/test-archives.mjs",
    "test:transfer": "node scripts/test-transfer.mjs",
    "test:repeat": "node scripts/test-repeat.mjs",
    "test:menu": "node scripts/test-task-menu.mjs",
    "test:settings": "node scripts/test-settings.mjs",
    "test:daily-capture": "node scripts/test-daily-capture.mjs",
    "test:progress": "node scripts/test-project-progress.mjs",
    "test:note-to-inbox": "node scripts/test-note-to-inbox.mjs",
    "test:someday": "node scripts/test-someday-presentation.mjs",
    "test:scheduling": "node scripts/test-scheduling.mjs",
    "test:controls": "node scripts/test-control-matrix.mjs",
    "test:dialogs": "node scripts/test-dialog-controls.mjs",
    "test:all-ui": "node scripts/test-all-ui.mjs",
    "test:visual-controls": "node scripts/test-visual-controls.mjs",
    "test:sidebar-spacing": "node scripts/test-sidebar-spacing.mjs",
    "test:theme-spacing": "node scripts/test-theme-spacing.mjs",
    "test:ordering": "node scripts/test-order-occurrences.mjs",
    "test:sync-safety": "node scripts/test-sync-safety.mjs",
    "test:touch": "node scripts/test-touch.mjs",
    "test:search": "node scripts/test-search.mjs",
    "test:waiting": "node scripts/test-waiting.mjs",
    "test:commands": "node scripts/test-commands.mjs",
    "test:menu-lifecycle": "node scripts/test-menu-lifecycle.mjs",
    "test:global-capture": "node scripts/test-global-capture.mjs",
    "test:global-hotkey-setting": "node scripts/test-global-hotkey-setting.mjs",
    "lint": "eslint --config scripts/eslint.config.js plugin scripts tests",
    "format": "prettier --write plugin scripts tests",
    "format:check": "prettier --check plugin scripts tests",
    "check": "npm run lint && npm run format:check && npm test",
    "test:list-counts": "node scripts/test-list-counts.mjs",
    "test:sidebar-navigation": "node scripts/test-sidebar-navigation.mjs",
    "build": "node scripts/build.mjs"
  },
  "devDependencies": {
    "eslint": "^10.13.0",
    "globals": "^17.13.0",
    "playwright-core": "^1.64.1",
    "prettier": "^3.9.10"
  },
  "license": "MIT",
  "prettier": {
    "singleQuote": true,
    "printWidth": 100,
    "trailingComma": "all"
  }
}
